// Prosperity Business - Schema Prisma
// Source de vérité : docs/BRIEF-PLATEFORME-PROSPERITY-BUSINESS.md (Section 3)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// ENUMS
// ────────────────────────────────────────────────────────────────────────────

enum Domaine {
  agriculture
  formation
}

enum TypeMedia {
  photo
  video
}

enum ModaliteFormation {
  presentiel
  terrain
  hybride
}

enum SujetLead {
  information
  partenariat
  formation
  commande
  autre
}

enum StatutLead {
  nouveau
  lu
  en_cours
  traite
  archive
}

enum StatutArticle {
  brouillon
  programme
  publie
  archive
}

enum RoleUser {
  super_admin
  admin_contenu
  membre
  partenaire
}

enum StatutCandidature {
  en_attente
  approuvee
  rejetee
}

enum TypeCandidature {
  partenaire
  membre
}

enum StatutProfilPublic {
  prive
  en_attente
  publie
}

// ────────────────────────────────────────────────────────────────────────────
// SERVICE
// ────────────────────────────────────────────────────────────────────────────

model Service {
  id                String   @id @default(uuid()) @db.Uuid
  titre             String   @db.VarChar(100)
  slug              String   @unique
  descriptionCourte String   @map("description_courte") @db.VarChar(200)
  descriptionLongue String?  @map("description_longue")
  domaine           Domaine
  sousCategorie     String?  @map("sous_categorie")
  icone             String?
  imageUrl          String?  @map("image_url")
  ordreAffichage    Int      @default(0) @map("ordre_affichage")
  estPublie         Boolean  @default(true) @map("est_publie")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  formations Formation[]
  medias     GalleryMedia[]

  @@index([domaine, estPublie])
  @@index([ordreAffichage])
  @@map("services")
}

// ────────────────────────────────────────────────────────────────────────────
// FORMATION
// ────────────────────────────────────────────────────────────────────────────

model Formation {
  id               String            @id @default(uuid()) @db.Uuid
  titre            String
  slug             String            @unique
  cible            String
  objectifs        String[]
  duree            String?
  modalite         ModaliteFormation
  cout             String?
  prochaineSession DateTime?         @map("prochaine_session") @db.Date
  description      String?
  imageUrl         String?           @map("image_url")
  estPublie        Boolean           @default(true) @map("est_publie")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  serviceId String?  @map("service_id") @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([estPublie])
  @@index([prochaineSession])
  @@map("formations")
}

// ────────────────────────────────────────────────────────────────────────────
// ARTICLE (blog / actualités)
// ────────────────────────────────────────────────────────────────────────────

model Article {
  id                 String        @id @default(uuid()) @db.Uuid
  titre              String
  slug               String        @unique
  contenu            String
  extrait            String?       @db.VarChar(300)
  imagePrincipaleUrl String?       @map("image_principale_url")
  auteur             String        @default("Prosperity Business")
  tags               String[]
  statut             StatutArticle @default(brouillon)
  estPublie          Boolean       @default(false) @map("est_publie")
  publieLe           DateTime?     @map("publie_le") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([estPublie, publieLe])
  @@index([tags])
  @@map("articles")
}

// ────────────────────────────────────────────────────────────────────────────
// GALLERY MEDIA
// ────────────────────────────────────────────────────────────────────────────

model GalleryMedia {
  id        String    @id @default(uuid()) @db.Uuid
  type      TypeMedia
  url       String
  legende   String?
  altText   String    @map("alt_text")
  categorie String?
  ordre     Int       @default(0)
  estPublie Boolean   @default(true) @map("est_publie")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  serviceId String?  @map("service_id") @db.Uuid
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([categorie, estPublie])
  @@index([serviceId])
  @@map("gallery_media")
}

// ────────────────────────────────────────────────────────────────────────────
// LEAD (formulaire de contact)
// ────────────────────────────────────────────────────────────────────────────

model Lead {
  id         String     @id @default(uuid()) @db.Uuid
  nomComplet String     @map("nom_complet")
  email      String
  telephone  String?
  sujet      SujetLead
  message    String
  statut     StatutLead @default(nouveau)
  notesAdmin String?    @map("notes_admin")
  ipHash     String?    @map("ip_hash")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  traiteLe   DateTime?  @map("traite_le") @db.Timestamptz

  @@index([statut, createdAt])
  @@index([email])
  @@map("leads")
}

// ────────────────────────────────────────────────────────────────────────────
// TEAM MEMBER
// ────────────────────────────────────────────────────────────────────────────

model TeamMember {
  id         String   @id @default(uuid()) @db.Uuid
  nomComplet String   @map("nom_complet")
  poste      String
  bio        String?
  photoUrl   String?  @map("photo_url")
  ordre      Int      @default(0)
  estPublie  Boolean  @default(true) @map("est_publie")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([estPublie, ordre])
  @@map("team_members")
}

// ────────────────────────────────────────────────────────────────────────────
// TESTIMONIAL
// ────────────────────────────────────────────────────────────────────────────

model Testimonial {
  id            String   @id @default(uuid()) @db.Uuid
  auteurNom     String   @map("auteur_nom")
  auteurQualite String?  @map("auteur_qualite")
  contenu       String   @db.VarChar(300)
  note          Int?
  photoUrl      String?  @map("photo_url")
  estPublie     Boolean  @default(false) @map("est_publie")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([estPublie])
  @@map("testimonials")
}

// ────────────────────────────────────────────────────────────────────────────
// USER (admins CMS)
// ────────────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  nomComplet        String    @map("nom_complet")
  passwordHash      String?   @map("password_hash")
  role              RoleUser  @default(admin_contenu)
  estActif          Boolean   @default(true) @map("est_actif")
  derniereConnexion DateTime? @map("derniere_connexion") @db.Timestamptz
  // Téléphone optionnel (utile pour membres/partenaires, contact, KkiaPay)
  telephone         String?
  // Profil public (membres et partenaires)
  organisation      String?
  secteur           String?
  bio               String?
  photoUrl          String?   @map("photo_url")
  logoUrl           String?   @map("logo_url")
  // State machine : prive → en_attente → publie (validation admin)
  statutProfilPublic    StatutProfilPublic @default(prive) @map("statut_profil_public")
  profilPublicSoumisLe  DateTime?          @map("profil_public_soumis_le") @db.Timestamptz
  profilPublicPublieLe  DateTime?          @map("profil_public_publie_le") @db.Timestamptz
  profilPublicNotesAdmin String?           @map("profil_public_notes_admin")
  slugPublic            String?            @unique @map("slug_public")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  resetTokens   PasswordResetToken[]
  candidatureId String?              @unique @map("candidature_id") @db.Uuid
  candidature   Candidature?         @relation(fields: [candidatureId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([role, estActif])
  @@index([statutProfilPublic, role])
  @@map("users")
}

// ────────────────────────────────────────────────────────────────────────────
// CANDIDATURE (devenir partenaire / membre - validation admin)
// ────────────────────────────────────────────────────────────────────────────

model Candidature {
  id           String            @id @default(uuid()) @db.Uuid
  type         TypeCandidature   @default(partenaire)
  nomComplet   String            @map("nom_complet")
  email        String
  telephone    String?
  organisation String?
  secteur      String?
  message      String
  statut       StatutCandidature @default(en_attente)
  notesAdmin   String?           @map("notes_admin")
  ipHash       String?           @map("ip_hash")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  traiteLe     DateTime?         @map("traite_le") @db.Timestamptz
  traiteParId  String?           @map("traite_par_id") @db.Uuid

  user User?

  @@index([statut, createdAt])
  @@index([email])
  @@map("candidatures")
}

// ────────────────────────────────────────────────────────────────────────────
// PASSWORD RESET TOKEN (sert aussi de token d'activation initiale)
// ────────────────────────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  // "invitation" = activation initiale (pas de mdp), "reset" = oubli mdp
  motif     String    @default("reset")
  expireLe  DateTime  @map("expire_le") @db.Timestamptz
  utiliseLe DateTime? @map("utilise_le") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expireLe])
  @@map("password_reset_tokens")
}

// ────────────────────────────────────────────────────────────────────────────
// SITE CONFIG (ligne unique)
// ────────────────────────────────────────────────────────────────────────────

model SiteConfig {
  id              String   @id @default(uuid()) @db.Uuid
  nomSite         String   @map("nom_site")
  slogan          String?
  emailContact    String   @map("email_contact")
  telephone1      String?  @map("telephone_1")
  telephone2      String?  @map("telephone_2")
  adresse         String?
  facebookUrl     String?  @map("facebook_url")
  instagramUrl    String?  @map("instagram_url")
  whatsappNumber  String?  @map("whatsapp_number")
  logoUrl         String?  @map("logo_url")
  faviconUrl      String?  @map("favicon_url")
  metaDescription String?  @map("meta_description") @db.VarChar(160)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("site_config")
}
