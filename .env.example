# ─────────────────────────────────────────────────────────────────────────
# Prosperity Business — Variables d'environnement
# Copier ce fichier en .env (jamais commiter .env)
# ─────────────────────────────────────────────────────────────────────────

# ─── Base de données Supabase Postgres ──────────────────────────────────
# DATABASE_URL : connexion pooled (utilisée par l'application en runtime)
# DIRECT_URL   : connexion directe (utilisée par Prisma pour les migrations)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Supabase API (côté client + serveur) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── NextAuth.js v5 ─────────────────────────────────────────────────────
# Générer la clé : openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ─── Resend (envoi d'emails) ────────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contact@prosperitybusiness.bj"
# Adresse qui reçoit les notifications de leads (AMBIG-007)
ADMIN_NOTIFICATION_EMAIL=""

# ─── Cloudinary (médias) ────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET="prosperity_unsigned"

# ─── Application ────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Prosperity Business"

# ─── Anti-spam (rate limiting) ──────────────────────────────────────────
# Optionnel : si non défini, fallback in-memory (single instance only)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
